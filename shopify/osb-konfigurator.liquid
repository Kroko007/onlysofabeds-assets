$("req").addEventListener("submit",e=>{
  const pos=S.pos.length?S.pos:[{qty:Math.max(1,parseInt($("qty").value)||1),txt:"(aktuelle Auswahl) "+model().n+" · "+fab().n+" "+fab().c[S.c][0]}];
  const total=pos.reduce((a,p)=>a+p.qty,0);
  const t=`PROJEKTANFRAGE onlysofabeds
Firma: ${$("co").value}
Ansprechperson: ${$("cp").value}
E-Mail: ${$("em").value} · Tel.: ${$("ph").value}
Projekt: ${$("pj").value}
Liefertermin: ${$("dt").value}
Brandschutz: ${$("fr").value}

POSITIONEN (${total} Stück total)
${pos.map((p,i)=>`${i+1}. ${p.qty} × ${p.txt}`).join("\n")}

Bemerkungen: ${$("nt").value}`;
  $("reqBody").value=t;try{sessionStorage.setItem("osb_sent","1")}catch(_){}
});
if(document.getElementById("reqOk")){S.pos=[];save();try{localStorage.removeItem("osb_pos")}catch(_){};document.getElementById("reqOk").scrollIntoView({block:"center"})}

$("copy").onclick=()=>{const t=$("out").textContent;
  const done=()=>{$("copyToast").textContent="Kopiert";setTimeout(()=>$("copyToast").textContent="",2000)};
  try{navigator.clipboard.writeText(t).then(done,()=>{sel();})}catch(e){sel()}
  function sel(){const r=document.createRange();r.selectNodeContents($("out"));const s=getSelection();s.removeAllRanges();s.addRange(r);$("copyToast").textContent="Text markiert, mit Cmd+C kopieren"}};
pickModel("indy");
window.addEventListener("osb3d-ready",()=>render());
</script>
<script type="module">
