}.osb *{box-sizing:border-box}.osb{background:var(--ivory);color:var(--espresso);font-family:var(--body);font-weight:300;font-size:15px;line-height:1.55}.osb .wrap{max-width:1240px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:20px 48px}.osb header{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:14px}.osb .brand{font-family:var(--display);font-size:30px;letter-spacing:.01em;line-height:1}.osb .brand em{color:var(--bordeaux);font-style:italic}.osb .claim{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--cocoa);margin-top:6px}.osb .draft{font-size:12px;color:var(--cocoa);max-width:42ch}.osb .grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:32px;margin-top:24px;align-items:start}@media (max-width:900px){.osb .grid{grid-template-columns:1fr}}.osb .stage{position:sticky;top:calc(var(--header-height,72px) + 12px);background:var(--stage);border-radius:4px;padding:24px;display:flex;flex-direction:column;gap:16px}@media (max-width:900px){.osb .stage{position:static}}.osb .stage h1{font-family:var(--display);font-weight:400;font-size:clamp(28px,4vw,40px);line-height:1.05;margin:0;text-wrap:balance}.osb .stage .sub{color:var(--cocoa);font-size:14px;margin-top:4px}.osb .svgbox{background:var(--paper);border-radius:3px;aspect-ratio:16/10;max-width:100%;display:grid;place-items:center;overflow:hidden}.osb .svgbox svg{width:100%;height:100%}.osb dl.spec{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0;font-size:14px}.osb dl.spec dt{color:var(--cocoa);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding-top:3px}.osb dl.spec dd{margin:0;min-width:0}.osb .sim{font-size:13px;color:var(--bordeaux);text-decoration:none;border-bottom:1px solid currentColor;align-self:flex-start}.osb .steps{display:flex;flex-direction:column;gap:28px}.osb section.step{display:flex;flex-direction:column;gap:12px}.osb .step h2{font-family:var(--display);font-weight:400;font-size:22px;margin:0;display:flex;gap:10px;align-items:baseline}.osb .step h2 span{font-family:var(--body);font-size:11px;letter-spacing:.18em;color:var(--bordeaux);text-transform:uppercase}.osb .hint{font-size:13px;color:var(--cocoa);margin:0}.osb .chips{display:flex;flex-wrap:wrap;gap:8px}.osb .chip{font:inherit;font-size:13px;font-weight:400;border:1px solid var(--line);background:var(--paper);color:var(--espresso);padding:7px 14px;border-radius:999px;cursor:pointer}.osb .chip[aria-pressed="true"]{background:var(--espresso);color:var(--paper);border-color:var(--espresso)}.osb .chip:disabled{opacity:.4;cursor:not-allowed}.osb .models{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}.osb .model{font:inherit;text-align:left;background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:10px 12px 12px;cursor:pointer;color:var(--espresso);display:flex;flex-direction:column;gap:4px}.osb .model img{width:100%;height:74px;object-fit:contain}.osb .svgbox{position:relative}.osb .svgbox canvas{max-width:92%;max-height:88%;display:block}.osb #pv3d{position:absolute;inset:0;display:none;cursor:grab;touch-action:none}.osb #pv3d canvas{width:100%!important;height:100%!important;max-width:none;max-height:none}.osb .svgbox[data-mode="3d"] #pv3d{display:block}.osb .svgbox[data-mode="3d"] #pvCanvas{visibility:hidden}.osb .modes{display:flex;gap:6px;flex-wrap:wrap}.osb .modes[hidden]{display:none}.osb .load3d{position:absolute;inset:auto 0 10px 0;text-align:center;font-size:12px;color:var(--cocoa)}.osb .photonote{font-size:11px;color:var(--cocoa);margin-top:-8px}@media (max-width:900px){.osb .stage{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;padding:12px 14px;gap:8px;flex-direction:row;align-items:center;border-radius:0 0 4px 4px}.osb .stage>div:first-child{order:2;flex:1;min-width:0}.osb .stage h1{font-size:22px}.osb .stage .sub,.osb .stage dl.spec,.osb .stage .sim,.osb .photonote{display:none}.osb .svgbox{order:1;width:42%;flex:none;aspect-ratio:16/10}}.osb .model b{font-family:var(--display);font-weight:500;font-size:17px}.osb .model small{color:var(--cocoa);font-size:12px;line-height:1.35}.osb .model[aria-pressed="true"]{border-color:var(--bordeaux);box-shadow:inset 0 0 0 1px var(--bordeaux)}.osb .fabrics{display:flex;flex-direction:column;gap:8px}.osb .fab{border:1px solid var(--line);background:var(--paper);border-radius:3px;padding:12px}.osb .fab[data-on="true"]{border-color:var(--bordeaux)}.osb .fabhead{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline}.osb .fabhead b{font-family:var(--display);font-weight:500;font-size:17px}.osb .tags{display:flex;gap:6px;flex-wrap:wrap}.osb .tag{font-size:11px;letter-spacing:.06em;padding:2px 8px;border-radius:999px;background:var(--bordeaux-soft);color:var(--bordeaux)}.osb .fabmeta{font-size:12px;color:var(--cocoa);margin:4px 0 8px}.osb .sw{display:flex;flex-wrap:wrap;gap:6px}.osb .swatch{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);cursor:pointer;padding:0}.osb .sw .more{padding:4px 12px;font-size:12px}.osb .swatch[aria-pressed="true"]{outline:2px solid var(--bordeaux);outline-offset:2px}.osb label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--cocoa)}.osb input,.osb select,.osb textarea{font:inherit;font-size:15px;text-transform:none;letter-spacing:0;color:var(--espresso);background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:9px 10px;width:100%}.osb .form{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media (max-width:520px){.osb .form{grid-template-columns:1fr}}.osb .form .full{grid-column:1/-1}.osb .btn{font:inherit;font-weight:400;font-size:14px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--espresso);background:transparent;color:var(--espresso);padding:12px 18px;border-radius:2px;cursor:pointer}.osb .btn.primary{background:var(--bordeaux);border-color:var(--bordeaux);color:#fff}.osb .btnrow{display:flex;gap:10px;flex-wrap:wrap}.osb .positions{display:flex;flex-direction:column;gap:6px}.osb .pos{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;background:var(--paper);border:1px solid var(--line);padding:8px 10px;border-radius:3px;font-size:14px}.osb .pos i{width:24px;height:24px;border-radius:50%;display:block;border:1px solid var(--line)}.osb .pos button{font:inherit;font-size:12px;background:none;border:0;color:var(--cocoa);cursor:pointer;text-decoration:underline}.osb .empty{font-size:13px;color:var(--cocoa);border:1px dashed var(--line);padding:12px;border-radius:3px}.osb pre#out{white-space:pre-wrap;background:var(--paper);border:1px solid var(--line);padding:14px;border-radius:3px;font-size:13px;font-family:var(--body);margin:0;max-height:360px;overflow:auto}.osb .toast{font-size:13px;color:var(--ok)}.osb :focus-visible{outline:2px solid var(--bordeaux);outline-offset:2px}@media (prefers-reduced-motion:no-preference){.osb .svgbox path,.osb .svgbox rect{transition:fill .35s ease}}.osb{padding-block:8px 40px}.osb .ok{background:#e7efe8;color:#2d5a3c;padding:12px 14px;border-radius:3px;font-size:14px}.osb .err{background:#f4e2e2;color:#7a2635;padding:12px 14px;border-radius:3px;font-size:14px}</style>


<div class="osb"><div class="wrap">
  <header>
    <div>
      <div class="brand">onlysofa<em>beds</em></div>
      <div class="claim">Sleep · Design · Hospitality</div>
    </div>
    <p class="draft">Projekt-Konfigurator für Hotels, Apartments, Pflege und Architekten. Preise auf Anfrage.</p>
  </header>

  <div class="grid">
    <aside class="stage" aria-label="Vorschau">
      <div>
        <h1 id="pvName">Indy</h1>
        <div class="sub" id="pvSub"></div>
      </div>
      <div class="modes" id="modes" hidden><button class="chip" data-mode="foto" aria-pressed="true">Foto</button><button class="chip" data-mode="3d" aria-pressed="false">3D drehen</button><span class="modes" id="bedmodes" hidden><button class="chip" data-bed="0" aria-pressed="true">Als Sofa</button><button class="chip" data-bed="1" aria-pressed="false">Als Bett ausklappen</button></span></div>
      <div class="svgbox" id="pvSvg" data-mode="foto"><canvas id="pvCanvas" aria-label="Vorschau in gewähltem Stoff"></canvas><div id="pv3d" aria-label="3D-Ansicht, mit Maus oder Finger drehen"></div><div class="load3d" id="load3d" hidden>3D-Modell wird geladen …</div></div>
      <p class="photonote" id="pvNote">Farbvorschau aus FAMA-Rendering, echte Stoffmuster auf Anfrage.</p>
      <dl class="spec" id="pvSpec"></dl>
      <a class="sim" href="https://famasofas.sim3d.es/" target="_blank" rel="noopener">Im 3D-Simulator ansehen ↗</a>
    </aside>

    <main class="steps">
      <section class="step">
        <h2><span>Schritt 1</span>Modell</h2>
        <div class="chips" role="group" aria-label="Typ">
          <button class="chip" data-type="sofa" aria-pressed="true">Schlafsofas</button>
          <button class="chip" data-type="sessel" aria-pressed="false">Schlafsessel</button>
        </div>
        <div class="chips" role="group" aria-label="Fuss">
          <button class="chip" data-leg="alle" aria-pressed="true">Alle</button>
          <button class="chip" data-leg="verdeckt" aria-pressed="false">Verdeckter Fuss</button>
          <button class="chip" data-leg="tief" aria-pressed="false">Tiefer Fuss</button>
          <button class="chip" data-leg="hoch" aria-pressed="false">Hoher Fuss</button>
        </div>
        <div class="models" id="models"></div>
      </section>

      <section class="step">
        <h2><span>Schritt 2</span>Ausführung</h2>
        <div id="variantBox" class="steps" style="gap:12px"></div>
      </section>

      <section class="step">
        <h2><span>Schritt 3</span>Matratze</h2>
        <p class="hint">Liegefläche 195 cm lang. Masse gemäss FAMA-Datenblättern (Stand 14.10.2026), Abweichungen von wenigen cm möglich.</p>
        <div id="mattBox" class="steps" style="gap:12px"></div>
      </section>

      <section class="step">
        <h2><span>Schritt 4</span>Stoff &amp; Farbe</h2>
        <div class="chips" role="group" aria-label="Stofffilter">
          <button class="chip" data-ff="alle" aria-pressed="true">Alle</button>
          <button class="chip" data-ff="neu" aria-pressed="false">Neu 2026</button>
          <button class="chip" data-ff="pflege" aria-pressed="false">Pflegeleicht</button>
          <button class="chip" data-ff="fr" aria-pressed="false">Schwer entflammbar</button>
          <button class="chip" data-ff="uni" aria-pressed="false">Uni</button>
          <button class="chip" data-ff="muster" aria-pressed="false">Muster</button>
          <button class="chip" data-ff="velours" aria-pressed="false">Velours, Bouclé, Cord</button>
        </div>
        <label class="f">Stoff suchen<input id="fq" type="search" placeholder="z. B. Axis 21 oder Titan" autocomplete="off"></label>
        <div class="hint" id="fcount">
        </div>
        <div class="fabrics" id="fabrics"></div>
        <p class="hint">Aus den FAMA-Kollektionen 2023–2026. Über 1000 weitere Stoffe auf Anfrage, Musterbox für die Bemusterung möglich.</p>
      </section>

      <section class="step">
        <h2><span>Schritt 5</span>Stückzahl</h2>
        <div class="form">
          <label class="f">Anzahl Stück<input id="qty" type="number" min="1" value="12"></label>
          <label class="f">Einsatzort<select id="room"><option>Hotelzimmer</option><option>Serviced Apartment</option><option>Pflegezimmer</option><option>Klinik / Reha</option><option>Familienzimmer</option><option>Lounge / Gemeinschaftsraum</option></select></label>
        </div>
        <div class="btnrow"><button class="btn" id="addPos">Zum Projekt hinzufügen</button><span class="toast" id="addToast" aria-live="polite"></span></div>
      </section>

      <section class="step">
        <h2><span>Projekt</span>Positionen</h2>
        <div class="positions" id="positions"></div>
      </section>

      <section class="step" id="anfrage" style="scroll-margin-top:110px">
        <h2><span>Anfrage</span>Ihre Angaben</h2>
        {%- form 'contact', id: 'req', class: 'form' -%}
          {%- if form.posted_successfully? -%}<p class="ok full" id="reqOk">Danke! Ihre Projektanfrage ist bei uns eingegangen. Wir melden uns innerhalb von 1–2 Arbeitstagen.</p>{%- endif -%}
          {%- if form.errors -%}<p class="err full">Bitte prüfen Sie Ihre Angaben: {{ form.errors | default_errors }}</p>{%- endif -%}
          <label class="f">Firma<input id="co" name="contact[Firma]" placeholder="z. B. Hotel Seeblick AG" required></label>
          <label class="f">Ansprechperson<input id="cp" name="contact[name]" placeholder="Vorname Name" required></label>
          <label class="f">E-Mail<input id="em" type="email" name="contact[email]" placeholder="name@firma.ch" required></label>
          <label class="f">Telefon<input id="ph" name="contact[phone]" placeholder="+41 …"></label>
          <label class="f">Projekt<input id="pj" name="contact[Projekt]" placeholder="z. B. Renovation 2. OG, 24 Zimmer"></label>
          <label class="f">Gewünschter Liefertermin<input id="dt" type="month" name="contact[Liefertermin]"></label>
          <label class="f full">Brandschutz<select id="fr" name="contact[Brandschutz]"><option>Keine besondere Anforderung</option><option>Schwer entflammbar erforderlich</option><option>Noch abklären</option></select></label>
          <label class="f full">Bemerkungen<textarea id="nt" rows="3" name="contact[Bemerkungen]" placeholder="z. B. Musterbox mit Stoffen gewünscht"></textarea></label>
          <textarea id="reqBody" name="contact[body]" hidden></textarea>
          <div class="btnrow full"><button class="btn primary" type="submit">Projektanfrage senden</button></div>
        {%- endform -%}
        <pre id="out" hidden></pre>
        <div class="btnrow" id="outBtns" hidden><button class="btn" id="copy">Text kopieren</button><span class="toast" id="copyToast" aria-live="polite"></span></div>
        <p class="hint">Die Anfrage geht direkt an onlysofabeds. Unverbindlich und kostenlos.</p>
      </section>
    </main>
  </div>
</div>
</div>

<script>window.OSB_BASE={{ section.settings.asset_base | json }};var OSB_BASE=window.OSB_BASE;</script>
