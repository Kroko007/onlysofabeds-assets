0px)) max(12px,env(safe-area-inset-left,0px));color:#f6f1e9;font-family:var(--body)}.osb .room[hidden],.osb .room [hidden]{display:none!important}.osb .room .rhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:10px}.osb .room .rhead b{font-family:var(--display);font-weight:400;font-size:24px}.osb .room .rclose{font:inherit;background:none;border:1px solid #f6f1e9;color:#f6f1e9;border-radius:999px;padding:6px 14px;cursor:pointer}.osb .room .rbody{flex:1;min-height:0;display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:14px}@media (max-width:820px){.osb .room .rbody{grid-template-columns:1fr;grid-template-rows:minmax(0,1fr) auto}}.osb .room .rstage{position:relative;min-height:0;display:grid;place-items:center;background:#1b1410;border-radius:4px;overflow:hidden}.osb .room .rframe{position:relative;max-width:100%;max-height:100%}.osb .room .rframe img{display:block;max-width:100%;max-height:calc(100vh - 160px);user-select:none;-webkit-user-drag:none}@media (max-width:820px){.osb .room .rframe img{max-height:calc(100vh - 330px)}}.osb .room .rframe canvas{position:absolute;inset:0;width:100%!important;height:100%!important;touch-action:none;cursor:grab}.osb .room .rempty{text-align:center;padding:30px;max-width:420px;display:flex;flex-direction:column;gap:14px;align-items:center}.osb .room .rempty p{color:#cbbfb2;font-size:14px}.osb .room .rup{font:inherit;font-size:13px;letter-spacing:.14em;text-transform:uppercase;background:var(--bordeaux);color:#fff;border:0;border-radius:2px;padding:14px 22px;cursor:pointer}.osb .room .rside{display:flex;flex-direction:column;gap:12px;overflow:auto;font-size:13px}.osb .room .rside label{display:flex;flex-direction:column;gap:4px;color:#cbbfb2;letter-spacing:.06em}.osb .room .rside input[type=range]{width:100%;accent-color:#d9a6ae}.osb .room .rside .rrow{display:flex;gap:8px;flex-wrap:wrap}.osb .room .rside button{font:inherit;font-size:12px;background:none;border:1px solid #8c7d70;color:#f6f1e9;border-radius:999px;padding:7px 12px;cursor:pointer}.osb .room .rside button.prim{background:#f6f1e9;color:#2e211b;border-color:#f6f1e9}.osb .room .rhint{font-size:12px;color:#a89786;line-height:1.45}@media (max-width:820px){.osb .room .rside{display:grid;grid-template-columns:1fr 1fr;gap:8px 12px}.osb .room .rside .full{grid-column:1/-1}}.osb .load3d{position:absolute;inset:auto 0 10px 0;text-align:center;font-size:12px;color:var(--cocoa)}.osb .photonote{font-size:11px;color:var(--cocoa);margin-top:-8px;line-height:1.45}.osb .chk span{display:flex;gap:8px;align-items:center;text-transform:none;letter-spacing:0;font-size:14px;color:var(--espresso)}.osb .chk input{width:auto}.osb .colornote{background:var(--paper);border-left:3px solid var(--bordeaux);padding:10px 12px;border-radius:2px}@media (max-width:900px){.osb .stage{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;padding:12px 14px;gap:8px;flex-direction:row;align-items:center;border-radius:0 0 4px 4px}.osb .stage>div:first-child{order:2;flex:1;min-width:0}.osb .stage h1{font-size:22px}.osb .stage .sub,.osb .stage dl.spec,.osb .stage .sim,.osb .photonote{display:none}.osb .svgbox{order:1;width:42%;flex:none;aspect-ratio:16/10}}.osb .model b{font-family:var(--display);font-weight:600;font-size:19px}.osb .model small{color:var(--cocoa);font-size:12px;line-height:1.35}.osb .model[aria-pressed="true"]{border-color:var(--bordeaux);box-shadow:inset 0 0 0 1px var(--bordeaux)}.osb .fabrics{display:flex;flex-direction:column;gap:8px}.osb .fab{border:1px solid var(--line);background:var(--paper);border-radius:3px;padding:12px}.osb .fab[data-on="true"]{border-color:var(--bordeaux)}.osb .fabhead{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline}.osb .fabhead b{font-family:var(--display);font-weight:600;font-size:19px}.osb .tags{display:flex;gap:6px;flex-wrap:wrap}.osb .tag{font-size:11px;letter-spacing:.06em;padding:2px 8px;border-radius:999px;background:var(--bordeaux-soft);color:var(--bordeaux)}.osb .fabmeta{font-size:12px;color:var(--cocoa);margin:4px 0 8px}.osb .sw{display:flex;flex-wrap:wrap;gap:6px}.osb .swatch{width:38px;height:38px;border-radius:50%;border:1px solid var(--line);cursor:pointer;padding:0}.osb .sw .more{padding:4px 12px;font-size:12px}.osb .swatch[aria-pressed="true"]{outline:2px solid var(--bordeaux);outline-offset:2px}.osb label.f{display:flex;flex-direction:column;gap:4px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--cocoa)}.osb input,.osb select,.osb textarea{font:inherit;font-size:15px;text-transform:none;letter-spacing:0;color:var(--espresso);background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:9px 10px;width:100%}.osb .form{display:grid;grid-template-columns:1fr 1fr;gap:12px}@media (max-width:520px){.osb .form{grid-template-columns:1fr}}.osb .form .full{grid-column:1/-1}.osb .btn{font:inherit;font-weight:400;font-size:14px;letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--espresso);background:transparent;color:var(--espresso);padding:12px 18px;border-radius:2px;cursor:pointer}.osb .btn.primary{background:#221B17;border-color:#221B17;color:#F4EFE8}.osb .btn.primary:hover{background:var(--bordeaux);border-color:var(--bordeaux)}.osb .btnrow{display:flex;gap:10px;flex-wrap:wrap}.osb .positions{display:flex;flex-direction:column;gap:6px}.osb .pos{display:grid;grid-template-columns:28px 1fr auto;gap:10px;align-items:center;background:var(--paper);border:1px solid var(--line);padding:8px 10px;border-radius:3px;font-size:14px}.osb .pos i{width:24px;height:24px;border-radius:50%;display:block;border:1px solid var(--line)}.osb .pos button{font:inherit;font-size:12px;background:none;border:0;color:var(--cocoa);cursor:pointer;text-decoration:underline}.osb .empty{font-size:13px;color:var(--cocoa);border:1px dashed var(--line);padding:12px;border-radius:3px}.osb pre#out{white-space:pre-wrap;background:var(--paper);border:1px solid var(--line);padding:14px;border-radius:3px;font-size:13px;font-family:var(--body);margin:0;max-height:360px;overflow:auto}.osb .toast{font-size:13px;color:var(--ok)}.osb :focus-visible{outline:2px solid var(--bordeaux);outline-offset:2px}@media (prefers-reduced-motion:no-preference){.osb .svgbox path,.osb .svgbox rect{transition:fill .35s ease}}.osb .qintro{position:relative;background:#382B20;color:#F4EFE8;overflow:hidden;min-height:300px;display:flex;align-items:center}.osb .qintro img{position:absolute;right:0;top:0;width:62%;height:100%;object-fit:cover}.osb .qintro .fade{position:absolute;inset:0;background:linear-gradient(90deg,#382B20 0%,#382B20 38%,rgba(56,43,32,.5) 52%,rgba(56,43,32,0) 70%)}.osb .qintro .t{position:relative;max-width:1240px;width:100%;margin:0 auto;padding:56px max(16px,env(safe-area-inset-left,0px));display:flex;flex-direction:column;gap:14px}.osb .qintro .t>*{max-width:520px}.osb .qintro span{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#E6D9C9}.osb .qintro h1{font-family:var(--display);font-weight:500;font-size:clamp(38px,4.6vw,60px);line-height:1.04;margin:0;color:#F4EFE8}.osb .qintro p{color:#E6D9C9;font-size:16px;margin:0}@media (max-width:760px){.osb .qintro{flex-direction:column;align-items:stretch;min-height:0}.osb .qintro img{position:relative;width:100%;height:200px}.osb .qintro .fade{display:none}.osb .qintro .t{padding-block:28px 32px}}.osb{padding-block:0 40px}.osb .ok{background:#e7efe8;color:#2d5a3c;padding:12px 14px;border-radius:3px;font-size:14px}.osb .err{background:#f4e2e2;color:#7a2635;padding:12px 14px;border-radius:3px;font-size:14px}</style>


<div class="osb"><section class="qintro"><img src="{{ section.settings.asset_base }}img/brand/kollektion.webp" alt="" width="1118" height="486"><div class="fade"></div>
  <div class="t"><span>Konfigurator</span><h1>Ihr Schlafsofa,<br>für Ihr Projekt gemacht.</h1><p>Modell, Ausführung, Matratze und Stoff wählen. Sie sehen das Sofa im gewählten Stoff, in 3D und in Ihrem eigenen Raum. Die Anfrage ist unverbindlich und kostenlos.</p></div></section><div class="wrap">
  

  <div class="grid">
    <aside class="stage" aria-label="Vorschau">
      <div>
        <h1 id="pvName">Indy</h1>
        <div class="sub" id="pvSub"></div>
      </div>
      <div class="modes" id="modes" hidden><button class="chip" data-mode="foto" aria-pressed="true">Foto</button><button class="chip" data-mode="3d" aria-pressed="false">3D drehen</button><button class="chip" id="photoBtn" data-photo="1" aria-pressed="false" hidden>✦ Fotoqualität</button><span class="modes" id="bedmodes" hidden><button class="chip" data-bed="0" aria-pressed="true">Als Sofa</button><button class="chip" data-bed="1" aria-pressed="false">Als Bett ausklappen</button></span></div>
      <button class="chip roombtn" id="roomOpen" hidden>📷 In meinem Raum ansehen</button>
      <div class="svgbox" id="pvSvg" data-mode="foto"><canvas id="pvCanvas" aria-label="Vorschau in gewähltem Stoff"></canvas><div id="pv3d" aria-label="3D-Ansicht, mit Maus oder Finger drehen"></div><div class="load3d" id="load3d" hidden>3D-Modell wird geladen …</div><div class="load3d" id="pt3d" hidden></div></div>
      <div class="scenes" id="scenes" role="group" aria-label="Raumstimmung">Raum: <button class="chip" data-scene="hell" aria-pressed="true">Hell</button><button class="chip" data-scene="warm" aria-pressed="false">Warm</button><button class="chip" data-scene="dunkel" aria-pressed="false">Dunkel</button></div>
      <p class="photonote" id="pvNote">Darstellung unverbindlich: Farben und Struktur können je nach Bildschirm, Licht und Produktionscharge vom Original abweichen. Massgebend ist das Stoffmuster.</p>
      <dl class="spec" id="pvSpec"></dl>
      <a class="sim" href="https://famasofas.sim3d.es/" target="_blank" rel="noopener">Im 3D-Simulator ansehen ↗</a>
    </aside>

    <main class="steps">
      <section class="step">
        <h2><span>Schritt 1</span>Modell</h2>
        <div class="chips" role="group" aria-label="Typ">
          <button class="chip" data-type="sofa" aria-pressed="true">Schlafsofas</button>
          <button class="chip" data-type="sessel" aria-pressed="false">Schlafsessel</button>
        </div>
        <div class="chips" role="group" aria-label="Fuss">
          <button class="chip" data-leg="alle" aria-pressed="true">Alle</button>
          <button class="chip" data-leg="verdeckt" aria-pressed="false">Verdeckter Fuss</button>
          <button class="chip" data-leg="tief" aria-pressed="false">Tiefer Fuss</button>
          <button class="chip" data-leg="hoch" aria-pressed="false">Hoher Fuss</button>
        </div>
        <div class="models" id="models"></div>
      </section>

      <section class="step">
        <h2><span>Schritt 2</span>Ausführung</h2>
        <div id="variantBox" class="steps" style="gap:12px"></div>
      </section>

      <section class="step">
        <h2><span>Schritt 3</span>Matratze</h2>
        <p class="hint">Liegefläche 195 cm lang. Masse gemäss FAMA-Datenblättern (Stand 14.10.2026), Abweichungen von wenigen cm möglich.</p>
        <div id="mattBox" class="steps" style="gap:12px"></div>
      </section>

      <section class="step">
        <h2><span>Schritt 4</span>Stoff &amp; Farbe</h2>
        <div class="chips" role="group" aria-label="Stofffilter">
          <button class="chip" data-ff="echt" aria-pressed="false">Echte Stoffe (fotografiert)</button><button class="chip" data-ff="alle" aria-pressed="true">Alle</button>
          <button class="chip" data-ff="neu" aria-pressed="false">Neu 2026</button>
          <button class="chip" data-ff="pflege" aria-pressed="false">Pflegeleicht</button>
          <button class="chip" data-ff="fr" aria-pressed="false">Schwer entflammbar</button>
          <button class="chip" data-ff="uni" aria-pressed="false">Uni</button>
          <button class="chip" data-ff="muster" aria-pressed="false">Muster</button>
          <button class="chip" data-ff="velours" aria-pressed="false">Velours, Bouclé, Cord</button>
        </div>
        <label class="f">Stoff suchen<input id="fq" type="search" placeholder="z. B. Axis 21 oder Titan" autocomplete="off"></label>
        <div class="hint" id="fcount">
        </div>
        <div class="fabrics" id="fabrics"></div>
        <p class="hint colornote"><b>Hinweis zu den Farben:</b> Die Stoffe werden digital dargestellt. Farben, Struktur und Glanz können je nach Bildschirm, Licht und Produktionscharge vom Original abweichen. Bitte bestellen Sie vor der Auftragserteilung kostenlose Stoffmuster.<br><b>Für 100 % Sicherheit:</b> Besuchen Sie uns im Showroom an der Schaffhauserstrasse 121 in 8152 Opfikon (bei Zürich). Dort sehen und fühlen Sie Stoffe und Modelle im Original. Termin einfach unten in der Anfrage ankreuzen.</p>
        <p class="hint">Über 1000 weitere Stoffe auf Anfrage, Musterbox für die Bemusterung möglich.</p>
      </section>

      <section class="step">
        <h2><span>Schritt 5</span>Stückzahl</h2>
        <div class="form">
          <label class="f">Anzahl Stück<input id="qty" type="number" min="1" value="12"></label>
          <label class="f">Einsatzort<select id="room"><option>Hotelzimmer</option><option>Serviced Apartment</option><option>Pflegezimmer</option><option>Klinik / Reha</option><option>Familienzimmer</option><option>Lounge / Gemeinschaftsraum</option></select></label>
        </div>
        <div class="btnrow"><button class="btn" id="addPos">Zum Projekt hinzufügen</button><span class="toast" id="addToast" aria-live="polite"></span></div>
      </section>

      <section class="step">
        <h2><span>Projekt</span>Positionen</h2>
        <div class="positions" id="positions"></div>
      </section>

      <section class="step" id="anfrage" style="scroll-margin-top:110px">
        <h2><span>Anfrage</span>Ihre Angaben</h2>
        {%- form 'contact', id: 'req', class: 'form' -%}
          {%- if form.posted_successfully? -%}<p class="ok full" id="reqOk">Danke! Ihre Projektanfrage ist bei uns eingegangen. Wir melden uns innerhalb von 1–2 Arbeitstagen.</p>{%- endif -%}
          {%- if form.errors -%}<p class="err full">Bitte prüfen Sie Ihre Angaben: {{ form.errors | default_errors }}</p>{%- endif -%}
          <label class="f">Firma<input id="co" name="contact[Firma]" placeholder="z. B. Hotel Seeblick AG" required></label>
          <label class="f">Ansprechperson<input id="cp" name="contact[name]" placeholder="Vorname Name" required></label>
          <label class="f">E-Mail<input id="em" type="email" name="contact[email]" placeholder="name@firma.ch" required></label>
          <label class="f">Telefon<input id="ph" name="contact[phone]" placeholder="+41 …"></label>
          <label class="f">Projekt<input id="pj" name="contact[Projekt]" placeholder="z. B. Renovation 2. OG, 24 Zimmer"></label>
          <label class="f">Gewünschter Liefertermin<input id="dt" type="month" name="contact[Liefertermin]"></label>
          <label class="f full">Brandschutz<select id="fr" name="contact[Brandschutz]"><option>Keine besondere Anforderung</option><option>Schwer entflammbar erforderlich</option><option>Noch abklären</option></select></label>
          <label class="f full chk"><span><input type="checkbox" id="st" name="contact[Showroom-Termin]" value="Ja"> Termin im Showroom Opfikon gewünscht</span></label>
          <label class="f full">Bemerkungen<textarea id="nt" rows="3" name="contact[Bemerkungen]" placeholder="z. B. Musterbox mit Stoffen gewünscht"></textarea></label>
          <textarea id="reqBody" name="contact[body]" hidden></textarea>
          <div class="btnrow full"><button class="btn primary" type="submit">Projektanfrage senden</button></div>
        {%- endform -%}
        <pre id="out" hidden></pre>
        <div class="btnrow" id="outBtns" hidden><button class="btn" id="copy">Text kopieren</button><span class="toast" id="copyToast" aria-live="polite"></span></div>
        <p class="hint">Die Anfrage geht direkt an onlysofabeds. Unverbindlich und kostenlos.</p>
      </section>
    </main>
  </div>
</div>
<div class="room" id="roomDlg" hidden role="dialog" aria-label="Sofa in meinem Raum">
  <div class="rhead"><b id="roomTitle">In meinem Raum</b><button class="rclose" id="roomClose">Schliessen</button></div>
  <div class="rbody">
    <div class="rstage" id="rstage">
      <div class="rempty" id="rempty"><p>Fotografieren Sie Ihren Raum, am besten aus Augenhöhe mit etwas Boden im Bild. Das Foto bleibt auf Ihrem Gerät und wird nicht hochgeladen.</p>
        <button class="rup" id="roomPick">Foto auswählen oder aufnehmen</button><input type="file" id="roomFile" accept="image/*" hidden></div>
      <div class="rframe" id="rframe" hidden><img id="roomImg" alt="Ihr Raum"><div id="room3d"></div></div>
    </div>
    <div class="rside" id="rside" hidden>
      <p class="rhint full">Simulation: Grösse, Farben und Licht können von der Wirklichkeit abweichen. Massgebend sind Masse und Stoffmuster.</p>
      <p class="rhint full">Sofa mit Finger oder Maus verschieben. Mit den Reglern passen Sie Grösse, Drehung und Perspektive an Ihr Foto an.</p>
      <label>Grösse<input type="range" id="rScale" min="40" max="220" value="100"></label>
