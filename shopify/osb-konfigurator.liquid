  const txt=`${m.n}${m.t==="sessel"?" Schlafsessel":""} · ${m.v[S.v]}${tw&&m.arms?" · Gesamtbreite "+tw+" cm":""} · Füsse ${m.legs[S.leg]} · Matratze ${mattText(m)} · Stoff ${fab().n} ${fab().c[S.c][0]} · ${$("room").value}`;
