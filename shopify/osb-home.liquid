{%- assign base = section.settings.asset_base -%}
{%- assign cfg = section.settings.configurator_url | default: '/pages/konfigurator' -%}
<style>
.qx{background:#F4EFE8;color:#2A1F19;font-family:"Jost","Helvetica Neue",Arial,sans-serif;font-weight:300;font-size:15px;line-height:1.6}
.qx *{box-sizing:border-box}.qx a{color:inherit;text-decoration:none}.qx p{margin:0}
.qx h1,.qx h2,.qx h3{font-family:"Cormorant Garamond",Georgia,serif;font-weight:500;margin:0;text-wrap:balance;color:inherit;letter-spacing:0}
.qx .w{max-width:1360px;margin:0 auto;padding-left:40px;padding-right:40px}
.qx .eb{font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#5E5146}
.qx .btn{align-self:flex-start;display:inline-flex;align-items:center;gap:14px;min-height:50px;padding:0 26px;background:#221B17;color:#F4EFE8;font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;transition:background .2s}
.qx .btn:hover{background:#6F343B}
.qx .btn.light{background:#F4EFE8;color:#221B17}.qx .btn.light:hover{background:#fff}
.qx .lnk{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.18em;text-transform:uppercase;padding:10px 0;border-bottom:1px solid currentColor}
.qx .hero{position:relative;background:#382B20;min-height:620px;overflow:hidden;display:flex;align-items:center}
.qx .hero>img{position:absolute;top:0;right:0;width:68%;height:100%;object-fit:cover;object-position:40% center}
.qx .hero .fade{position:absolute;inset:0;background:linear-gradient(90deg,#382B20 0%,#382B20 32%,rgba(56,43,32,.55) 46%,rgba(56,43,32,0) 62%)}
.qx .hero .txt{position:relative;width:100%;padding-block:88px}
.qx .hero .box{max-width:540px;display:flex;flex-direction:column;gap:22px;color:#F4EFE8}
.qx .hero .eb{color:#E6D9C9}
.qx .hero h1{font-size:clamp(44px,5.4vw,76px);line-height:1.02}
.qx .hero p{font-size:17px;color:#E6D9C9;max-width:44ch}
.qx .hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
.qx .hero .btn.ghost{background:transparent;border:1px solid #F4EFE8}.qx .hero .btn.ghost:hover{background:#F4EFE8;color:#221B17}
@media (max-width:860px){.qx .w{padding-left:16px;padding-right:16px}.qx .hero{min-height:0;flex-direction:column;align-items:stretch}
 .qx .hero>img{position:relative;width:100%;height:300px}.qx .hero .fade{display:none}.qx .hero .txt{padding-block:36px 44px}}
.qx .need{padding-block:56px 72px;display:flex;flex-direction:column;gap:28px}
.qx .head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px 24px}
.qx .head h2{font-size:40px;line-height:1.1}
.qx .cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.qx .card{display:flex;flex-direction:column;gap:14px}
.qx .card img{width:100%;aspect-ratio:5/3;object-fit:cover;display:block;transition:opacity .2s}
.qx .card:hover img{opacity:.9}
.qx .card .t{display:flex;justify-content:space-between;gap:12px}
.qx .card b{display:block;font-family:"Cormorant Garamond",Georgia,serif;font-size:24px;font-weight:500;line-height:1.2}
.qx .card small{font-size:13px;color:#6B5E52}
@media (max-width:1000px){.qx .cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.qx .cards{grid-template-columns:1fr}}
.qx .coll{display:flex;flex-wrap:wrap;background:#F7F3EE}
.qx .coll>img{flex:1 1 520px;min-width:0;width:46%;min-height:420px;object-fit:cover;display:block}
.qx .coll .c{flex:1 1 520px;min-width:0;padding:56px 40px 56px 48px;display:flex;flex-wrap:wrap;gap:40px;align-items:center}
.qx .coll .c>div{flex:1 1 300px;min-width:0;display:flex;flex-direction:column;gap:20px}
.qx .coll h2{font-size:clamp(36px,3.4vw,48px);line-height:1.05}
.qx .coll p{font-size:14px;line-height:1.75;color:#4E4339;max-width:420px}
.qx .coll .mini{flex:0 1 210px;min-width:180px;background:#E9E2D8;display:flex;flex-direction:column}
.qx .coll .mini img{width:100%;aspect-ratio:8/7;object-fit:cover;display:block}
.qx .coll .mini span{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
@media (max-width:860px){.qx .coll .c{padding:40px 16px}.qx .coll>img{min-height:260px}}
.qx .cfg{background:#221B17;color:#F4EFE8}
.qx .cfg .w{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:40px;align-items:center;padding-block:64px}
.qx .cfg h2{font-size:clamp(34px,3.4vw,46px);line-height:1.08}
.qx .cfg p{color:#CFC4B6;margin-top:14px;max-width:44ch}
.qx .cfg ol{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px;counter-reset:s}
.qx .cfg li{border-top:1px solid #6B5E52;padding-top:14px;counter-increment:s;font-size:14px}
.qx .cfg li::before{content:"0" counter(s);display:block;font-family:"Cormorant Garamond",Georgia,serif;font-size:28px;color:#D9B8AE;margin-bottom:4px}
.qx .cfg li small{display:block;color:#a89786;font-size:12px;line-height:1.45;margin-top:2px}
.qx .cfg .btn{margin-top:26px}
@media (max-width:960px){.qx .cfg .w{grid-template-columns:1fr}.qx .cfg ol{grid-template-columns:repeat(2,minmax(0,1fr))}}
.qx .guide{display:flex;flex-wrap:wrap;background:#EDE6DC}
.qx .guide .l{flex:1 1 520px;min-width:0;display:flex;flex-wrap:wrap;background:#E6DED3}
.qx .guide .l img{flex:1 1 220px;min-width:0;min-height:280px;width:45%;object-fit:cover;display:block}
.qx .guide .l>div{flex:1 1 260px;min-width:0;padding:44px 36px;display:flex;flex-direction:column;gap:18px;justify-content:center}
.qx .guide h2{font-size:32px;line-height:1.15}
.qx .guide p{font-size:14px;line-height:1.7;color:#4E4339}
.qx .ben{flex:1 1 520px;min-width:0;padding:48px 56px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 32px;align-content:center}
.qx .ben div{display:flex;flex-direction:column;gap:8px}
.qx .ben b{font-size:14px;font-weight:500}
.qx .ben small{font-size:12px;line-height:1.5;color:#5E5146}
@media (max-width:860px){.qx .ben{padding:40px 16px;grid-template-columns:repeat(2,minmax(0,1fr))}.qx .guide .l>div{padding:36px 16px}}
.qx .show{padding-block:72px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center}
.qx .show h2{font-size:clamp(34px,3.4vw,46px);line-height:1.08}
.qx .show p{color:#4E4339;margin-top:14px;max-width:46ch}
.qx .show address{font-style:normal;font-size:14px;line-height:1.7;border-left:1px solid #2A1F19;padding-left:20px}
@media (max-width:760px){.qx .show{grid-template-columns:1fr;padding-block:48px}}
</style>
<div class="qx">
  <section class="hero">
    <img src="{{ base }}img/brand/hero.webp" alt="Helles Bouclé-Schlafsofa in einem warmen Wohnraum mit Marmortisch" width="1568" height="744" fetchpriority="high">
    <div class="fade" aria-hidden="true"></div>
    <div class="txt w">
      <div class="box">
        <span class="eb">Tagsüber Sofa. Nachts ein echtes Bett.</span>
        <h1>Mehr als ein Sofa.<br>Ein Raum, der mehr kann.</h1>
        <p>Design-Schlafsofas für Hotels, Serviced Apartments und Pflege. In Ihrem Stoff, in Ihrer Stückzahl.</p>
        <div class="ctas">
          <a class="btn light" href="{{ cfg }}">Jetzt konfigurieren <span aria-hidden="true">→</span></a>
          <a class="btn ghost" href="#kollektion">Kollektion entdecken</a>
        </div>
      </div>
    </div>
  </section>

  <section class="need w" aria-labelledby="need-h">
    <div class="head">
      <h2 id="need-h">Für jeden Raum das richtige Modell</h2>
      <a class="lnk" href="{{ cfg }}">Alle Modelle <span aria-hidden="true">→</span></a>
    </div>
    <div class="cards">
      <a class="card" href="{{ cfg }}"><img src="{{ base }}img/brand/kachel-klein.webp" alt="Kompaktes helles Schlafsofa im Stadt-Apartment" width="494" height="300" loading="lazy"><span class="t"><span><b>Serviced Apartments</b><small>Kompakt, wohnlich, schnell zum Bett.</small></span><span aria-hidden="true">→</span></span></a>
      <a class="card" href="{{ cfg }}"><img src="{{ base }}img/brand/kachel-gruen.webp" alt="Grünes Schlafsofa in einem hellen Zimmer" width="494" height="300" loading="lazy"><span class="t"><span><b>Hotelzimmer</b><small>Zusatzbett ohne Kompromisse beim Design.</small></span><span aria-hidden="true">→</span></span></a>
      <a class="card" href="{{ cfg }}"><img src="{{ base }}img/brand/kachel-bett.webp" alt="Ausgeklapptes Schlafsofa mit bezogenem Bett" width="494" height="300" loading="lazy"><span class="t"><span><b>Familien- &amp; Pflegezimmer</b><small>Echte Matratze, 195 cm Liegelänge.</small></span><span aria-hidden="true">→</span></span></a>
      <a class="card" href="{{ cfg }}"><img src="{{ base }}img/brand/kachel-bordeaux.webp" alt="Bordeaux-Schlafsofa in Samt in einem dunklen Interieur" width="492" height="300" loading="lazy"><span class="t"><span><b>Lounge &amp; Suiten</b><small>Zeitlose Stücke mit Wirkung.</small></span><span aria-hidden="true">→</span></span></a>
    </div>
  </section>

  <section class="coll" id="kollektion" aria-labelledby="coll-h">
    <img src="{{ base }}img/brand/kollektion.webp" alt="Grosses helles Schlafsofa in einem sonnigen Raum mit Rundbogenfenster" width="1118" height="486" loading="lazy">
    <div class="c">
      <div>
        <span class="eb">Die Kollektion</span>
        <h2 id="coll-h">Form trifft Funktion.</h2>
        <p>Unsere Schlafsofas verbinden echten Schlafkomfort, ruhiges Design und durchdachte Mechanik. Vom kompakten Sessel bis zum grosszügigen Viersitzer, mit verdeckten, tiefen oder hohen Füssen.</p>
        <a class="btn" href="{{ cfg }}">Alle Schlafsofas ansehen <span aria-hidden="true">→</span></a>
      </div>
      <a class="mini" href="{{ cfg }}">
        <img src="{{ base }}img/brand/mechanik.webp" alt="Mechanik eines Schlafsofas beim Ausklappen" width="316" height="276" loading="lazy">
        <span>So funktioniert’s <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z"/></svg></span>
      </a>
    </div>
  </section>

  <section class="cfg" aria-labelledby="cfg-h">
    <div class="w">
      <div>
        <span class="eb" style="color:#CFC4B6">Konfigurator</span>
        <h2 id="cfg-h">In fünf Schritten zu Ihrem Projekt.</h2>
        <p>Modell, Ausführung, Matratze, Stoff und Stückzahl wählen. Sie sehen Ihr Sofa im gewählten Stoff, in 3D und auf Wunsch in Ihrem eigenen Raum.</p>
        <a class="btn light" href="{{ cfg }}">Konfigurator öffnen <span aria-hidden="true">→</span></a>
      </div>
      <ol>
        <li>Modell<small>Sofa oder Sessel</small></li>
        <li>Ausführung<small>Armlehnen und Füsse</small></li>
        <li>Matratze<small>Breite, Dicke, Qualität</small></li>
        <li>Stoff<small>Hunderte Farben</small></li>
        <li>Anfrage<small>unverbindlich, kostenlos</small></li>
      </ol>
    </div>
  </section>

  <section class="guide" aria-labelledby="guide-h">
    <div class="l">
      <img src="{{ base }}img/brand/stoff.webp" alt="Nahaufnahme: Kissen in Bordeaux-Samt auf strukturiertem Stoff" width="600" height="414" loading="lazy">
      <div>
        <h2 id="guide-h">Ein schönes Sofa.<br>Eine erholsame Nacht.</h2>
        <p>Stoffe, Farben und Matratzen sieht und fühlt man am besten im Original. Wir schicken Ihnen Stoffmuster oder zeigen Ihnen alles im Showroom.</p>
        <a class="lnk" href="#showroom">Showroom-Termin <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="ben">
      <div><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2A1F19" stroke-width="1.2"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M3 12h18M6 17v2M18 17v2"/></svg><b>Echter Schlafkomfort</b><small>Richtige Matratzen statt Notlösung.</small></div>
      <div><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2A1F19" stroke-width="1.2"><path d="M12 3c3 4 5 6.5 5 10a5 5 0 0 1-10 0c0-2 1-3.5 2-5 0 2 1 3 2 3 0-3 0-5 1-8z"/></svg><b>Brandschutz</b><small>Schwer entflammbare Stoffe und Matratzen auf Anfrage.</small></div>
      <div><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2A1F19" stroke-width="1.2"><circle cx="8" cy="8" r="4"/><circle cx="16" cy="8" r="4"/><circle cx="12" cy="15" r="4"/></svg><b>Grosse Stoffauswahl</b><small>Uni, Muster, Velours, Bouclé und Cord.</small></div>
      <div><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2A1F19" stroke-width="1.2"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg><b>Projektlieferung</b><small>Geplant auf Ihren Termin.</small></div>
      <div><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2A1F19" stroke-width="1.2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg><b>Persönliche Beratung</b><small>Ein Ansprechpartner für Ihr Projekt.</small></div>
      <div><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#2A1F19" stroke-width="1.2"><path d="M3 12l6-7h6l6 7-9 9z"/><path d="M3 12h18M9 5l3 16M15 5l-3 16"/></svg><b>Europäische Fertigung</b><small>Hergestellt in Spanien.</small></div>
    </div>
  </section>

  <section class="show w" id="showroom" aria-labelledby="show-h">
    <div>
      <span class="eb">Showroom</span>
      <h2 id="show-h">Für 100 % Sicherheit: im Original ansehen.</h2>
      <p>Farben wirken auf jedem Bildschirm anders. Im Showroom sehen und fühlen Sie Stoffe, Matratzen und Modelle. Wir nehmen uns Zeit für Ihr Projekt.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px"><a class="btn" href="{{ cfg }}#anfrage">Termin anfragen <span aria-hidden="true">→</span></a></div>
    </div>
    <address>
      <b style="font-weight:500">onlysofabeds Showroom</b><br>
      {{ section.settings.address | newline_to_br }}
    </address>
  </section>
</div>
{% schema %}
{
  "name": "OSB Startseite",
  "class": "osb-home-section",
  "settings": [
    {"type": "text", "id": "asset_base", "label": "Adresse der Bilder", "default": "https://cdn.jsdelivr.net/gh/Kroko007/onlysofabeds-assets@main/"},
    {"type": "url", "id": "configurator_url", "label": "Link zum Konfigurator"},
    {"type": "textarea", "id": "address", "label": "Adresse Showroom", "default": "Schaffhauserstrasse 121\n8152 Opfikon (bei Zürich)\nBesuch nach Vereinbarung"}
  ],
  "presets": [{"name": "OSB Startseite"}]
}
{% endschema %}
