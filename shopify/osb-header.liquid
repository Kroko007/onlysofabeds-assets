{%- assign base = section.settings.asset_base -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Jost:wght@300;400;500&display=swap">
<style>
:root{--q-ivory:#F4EFE8;--q-sand:#EEE7DE;--q-line:#DDD3C6;--q-ink:#2A1F19;--q-night:#221B17;--q-cocoa:#382B20;--q-muted:#5E5146;--q-wine:#6F343B;
 --q-serif:"Cormorant Garamond",Georgia,serif;--q-sans:"Jost","Helvetica Neue",Arial,sans-serif}
body{background:var(--q-ivory)}
.qh{position:sticky;top:0;z-index:50;font-family:var(--q-sans);color:var(--q-ink)}
.qh a{color:inherit;text-decoration:none}
.qh .bar{background:var(--q-night);color:#EDE5DA;text-align:center;padding:9px 16px;font-size:11px;letter-spacing:.2em;text-transform:uppercase}
.qh .hd{background:var(--q-sand);border-bottom:1px solid var(--q-line)}
.qh .in{max-width:1360px;margin:0 auto;padding:10px 40px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:16px}
.qh nav{display:flex;flex-wrap:wrap;gap:4px 32px;font-size:13px;letter-spacing:.02em}
.qh nav a{padding:12px 0;border-bottom:1px solid transparent}
.qh nav a:hover,.qh nav a[aria-current="page"]{border-bottom-color:var(--q-ink)}
.qh .logo img{height:64px;width:auto;display:block}
.qh .right{display:flex;justify-content:flex-end;align-items:center;gap:6px}
.qh .ic{width:44px;height:44px;display:flex;align-items:center;justify-content:center}
.qh .cta{display:inline-flex;align-items:center;gap:10px;min-height:44px;padding:0 20px;background:var(--q-night);color:var(--q-ivory)!important;font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:500}
.qh .cta:hover{background:var(--q-wine)}
.qh details{display:none}
.qh details summary{list-style:none;cursor:pointer}.qh details summary::-webkit-details-marker{display:none}
@media (max-width:900px){
 .qh .in{padding:6px 16px;grid-template-columns:44px 1fr auto}
 .qh nav.desk{display:none}.qh details{display:block}
 .qh .logo{justify-self:center}.qh .logo img{height:48px}
 .qh .cta{padding:0 12px;font-size:10px;letter-spacing:.12em}.qh .ic.search{display:none}
 .qh details[open] .drop{position:absolute;left:0;right:0;top:100%;background:var(--q-sand);border-bottom:1px solid var(--q-line);padding:8px 16px 16px;display:flex;flex-direction:column}
 .qh details .drop a{padding:12px 0;border-bottom:1px solid var(--q-line);font-size:15px}
 .qh .bar{font-size:10px;letter-spacing:.14em}
}
</style>
<header class="qh">
  {%- if section.settings.bar != blank -%}<div class="bar">{{ section.settings.bar }}</div>{%- endif -%}
  <div class="hd" style="position:relative">
    <div class="in">
      <details>
        <summary class="ic" aria-label="Menü öffnen"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 7h18M3 12h18M3 17h18"/></svg></summary>
        <div class="drop">
          {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        </div>
      </details>
      <nav class="desk" aria-label="Hauptnavigation">
        {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>{%- endfor -%}
      </nav>
      <a class="logo" href="{{ routes.root_url }}" aria-label="onlysofabeds Startseite"><img src="{{ base }}img/brand/logo-dunkel.webp" alt="onlysofabeds" width="768" height="506"></a>
      <div class="right">
        <a class="ic search" href="{{ routes.search_url }}" aria-label="Suche"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
        <a class="cta" href="{{ section.settings.cta_url | default: '/pages/konfigurator' }}">{{ section.settings.cta_label | default: 'Konfigurieren' }} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "OSB Kopfzeile",
  "class": "osb-header-section",
  "settings": [
    {"type": "text", "id": "bar", "label": "Ankündigung", "default": "Schlafsofas für Hotels, Apartments & Pflege · Showroom Opfikon bei Zürich"},
    {"type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu"},
    {"type": "text", "id": "cta_label", "label": "Button-Text", "default": "Konfigurieren"},
    {"type": "url", "id": "cta_url", "label": "Button-Link"},
    {"type": "text", "id": "asset_base", "label": "Adresse der Bilder", "default": "https://cdn.jsdelivr.net/gh/Kroko007/onlysofabeds-assets@main/"}
  ]
}
{% endschema %}
